# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Google Cloud Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.appspot.com

# Optional: Path to serviceAccountKey.json if preferred over individual env vars
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Vision & Conversational AI API (Google Gemini)
AI_API_KEY=your_gemini_api_key
AI_MODEL_NAME=gemini-1.5-flash

# Application Timezone
TIMEZONE=Asia/Jakarta
